   "source": [
    "# Jawaban A5:"class LinearRegressionGD:

  def __init__(self, lr=0.01, n_iterations=5000):
    self.lr = lr
    self.n_iterations = n_iterations
    self.losses = []

  def fit(self, X, y):
    n_samples, n_features = X.shape
    self.w = np.zeros(n_features)
    self.b = 0
    self.losses = []

    for _ in range(self.n_iterations):
      y_pred = np.dot(X, self.w) + self.b
      loss = np.mean((y - y_pred) ** 2)
      self.losses.append(loss)

      # Gradient calculation
      dw = (-2 / n_samples) * np.dot(X.T, (y - y_pred))
      db = (-2 / n_samples) * np.sum(y - y_pred)

      # Update parameters
      self.w -= self.lr * dw
      self.b -= self.lr * db


learning_rates = [0.001, 0.02, 0.1]
models_gd = {}

plt.figure(figsize=(10, 6))

for lr in learning_rates:
  model_gd = LinearRegressionGD(lr=lr, n_iterations=5000)
  model_gd.fit(X_train_a, y_train_a)
  models_gd[lr] = model_gd

  print(
      f'LR = {lr:<5} | Intercept (b): {model_gd.b:.4f} | Slope (m):'
      f' {model_gd.w[0]:.4f}'
  )

  # Plotting loss history
  plt.plot(
      range(len(model_gd.losses)), model_gd.losses, label=f'LR = {lr}'
  )

plt.title('Loss (MSE) vs Iterasi untuk Berbagai Learning Rate')
plt.xlabel('Iterasi')
plt.ylabel('Loss (MSE)')
plt.yscale('log')
