   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Jawaban A3: # Implementasi Class LinearRegression (Normal Equation)
class LinearRegression:

  def fit(self, X, y):
    # Tambahkan kolom bias (intercept)
    X_b = np.c_[np.ones((len(X), 1)), X]
    # Formula Normal Equation: theta = (X^T * X)^(-1) * X^T * y
    theta = np.linalg.inv(X_b.T.dot(X_b)).dot(X_b.T).dot(y)
    self.intercept_ = theta[0]
    self.coef_ = theta[1:]

  def predict(self, X):
    return X.dot(self.coef_) + self.intercept_


model_lr = LinearRegression()
model_lr.fit(X_train_a, y_train_a)

b = model_lr.intercept_
m = model_lr.coef_[0]

print(f'Intercept (b) : {b:.4f}')
print(f'Koefisien (m) : {m:.4f}')
print(f'Persamaan Garis: y_hat = {b:.4f} + {m:.4f} * X')"
