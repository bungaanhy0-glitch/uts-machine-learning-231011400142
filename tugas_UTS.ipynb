    "# Jawaban A4:# "Fungsi evaluasi regresi dengan NumPy
def calculate_mae(y_true, y_pred):
  return np.mean(np.abs(y_true - y_pred))
def calculate_mse(y_true, y_pred):
  return np.mean((y_true - y_pred) ** 2)
def calculate_rmse(y_true, y_pred):
  return np.sqrt(calculate_mse(y_true, y_pred))
def calculate_r2(y_true, y_pred):
  ss_res = np.sum((y_true - y_pred) ** 2)
  ss_tot = np.sum((y_true - np.mean(y_true)) ** 2)
  return 1 - (ss_res / ss_tot)
# Prediksi
y_train_pred_a = model_lr.predict(X_train_a)
y_test_pred_a = model_lr.predict(X_test_a)
# Tabel Hasil
metrics_data = {
    'Dataset': ['Data Training', 'Data Testing'],
    'MAE': [
        calculate_mae(y_train_a, y_train_pred_a),
        calculate_mae(y_test_a, y_test_pred_a),
    ],
    'MSE': [
        calculate_mse(y_train_a, y_train_pred_a),
        calculate_mse(y_test_a, y_test_pred_a),
    ],
    'RMSE': [
        calculate_rmse(y_train_a, y_train_pred_a),
        calculate_rmse(y_test_a, y_test_pred_a),
    ],
    'R2': [
